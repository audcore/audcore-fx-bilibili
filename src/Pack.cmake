file(WRITE "${OUT}" "#pragma once\nnamespace bilibili {\n")
function(pack name path)
 file(READ "${SOURCE}/${path}" bytes HEX)
 string(REGEX REPLACE "^efbbbf" "" bytes "${bytes}")
 string(REGEX REPLACE "(..)" "\\\\x\\1" escaped "${bytes}")
 string(LENGTH "${escaped}" total)
 file(APPEND "${OUT}" "inline constexpr char ${name}[] =\n")
 set(offset 0)
 while(offset LESS total)
  string(SUBSTRING "${escaped}" ${offset} 4096 part)
  file(APPEND "${OUT}" "    \"${part}\"\n")
  math(EXPR offset "${offset}+4096")
 endwhile()
 file(APPEND "${OUT}" ";\n")
endfunction()
pack(definition definition.json)
pack(html web/index.html)
pack(css web/panel.css)
pack(panelJs web/panel.mjs)
pack(routesJs web/routes.mjs)
file(APPEND "${OUT}" "}\n")
